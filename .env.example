# Public URL of this Next.js app (used by Better Auth for redirects and trusted origins)
BETTER_AUTH_URL=http://localhost:3000
# Random string, at least 32 characters
BETTER_AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# MongoDB Atlas (same cluster/database the API uses)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=studiospace

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Express API: base URL for the /api rewrite, and the secret shared with the API to sign the HTTPOnly auth JWT
API_URL=http://localhost:5000
API_JWT_SECRET=replace-with-the-same-value-as-the-server-JWT_SECRET
AUTH_COOKIE_NAME=studiospace_token
